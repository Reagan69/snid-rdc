# ───────── Base de données PostgreSQL (Neon via Vercel Marketplace, Supabase, RDS…) ─────────
# DATABASE_URL : connexion POOLÉE (PgBouncer) utilisée par l'application serverless.
# DIRECT_URL   : connexion DIRECTE (sans pool) utilisée par « prisma migrate ».
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/snid?sslmode=require&pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/snid?sslmode=require"

# ───────── Application ─────────
APP_URL="http://localhost:3000"          # URL publique (https://… en production) : origine CSRF et QR des cartes

# ───────── Secrets (générer avec : openssl rand -base64 32) ─────────
ENCRYPTION_KEY=""                        # AES-256-GCM : secrets TOTP, futures données biométriques
SIGNING_SECRET=""                        # HMAC : QR des cartes
CRON_SECRET=""                           # Vercel l'envoie en « Authorization: Bearer » aux tâches planifiées

# ───────── Limitation de débit (Redis REST : Upstash / Vercel Marketplace) ─────────
# Facultatif en développement (repli en mémoire) ; recommandé en production.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ───────── Sécurité ─────────
MFA_ENFORCE="false"                      # « true » : MFA obligatoire pour ADMIN, AUDITEUR, GOUVERNEUR
SESSION_TTL_HOURS="8"
BIOMETRICS_REAL_ENABLED="false"          # reste « false » tant que la biométrie réelle n'est pas validée

# ───────── Jeu de données initial (prisma db seed) ─────────
SEED_ADMIN_USERNAME="n.kasongo"
SEED_ADMIN_PASSWORD=""                   # 12 caractères minimum
SEED_DEMO="false"                        # « true » : comptes et citoyens FICTIFS de démonstration
SEED_DEMO_PASSWORD=""                    # 12 caractères minimum (obligatoire si SEED_DEMO=true)
